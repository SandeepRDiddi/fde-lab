# Copy to .env for a single default cohort, or to a cohort-specific file
# (e.g. .env.cohort-a) and pass --env-file when running a second cohort
# side by side (see docker-compose.yml header comment).

# Isolates containers/network/named volumes per cohort — set a distinct value
# per cohort, or pass -p <name> on the docker compose command line instead.
COMPOSE_PROJECT_NAME=fde-lab

# Postgres
POSTGRES_USER=fde
POSTGRES_PASSWORD=fde
POSTGRES_DB=fde_lab

# MinIO (local S3-compatible store)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=fde-lab-datasets

# PromptOps Gateway — external dependency, not part of this compose file.
# No gateway exists yet, so this defaults (in docker-compose.yml) to a local
# Ollama instance on the host machine -- free, open-source models, no
# hosted-API cost. Install Ollama (https://ollama.com) and pull a model
# before starting the stack:
#   ollama pull llama3.2:3b
# Leave these unset to use that default; only override PROMPTOPS_GATEWAY_URL
# once a real gateway exists, or PROMPTOPS_GATEWAY_MODEL to use a different
# pulled model.
PROMPTOPS_GATEWAY_URL=
PROMPTOPS_GATEWAY_API_KEY=
PROMPTOPS_GATEWAY_MODEL=

# Host-published ports — override these per cohort to avoid collisions when
# running two cohorts on the same machine at once.
BACKEND_PORT=8000
PERSONA_PORT=8001
FRONTEND_PORT=3000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
